# Newsletter IMAP Integration
NEWSLETTER_ENABLED=true
NEWSLETTER_IMAP_HOST=imap.gmail.com
NEWSLETTER_IMAP_PORT=993
NEWSLETTER_IMAP_USERNAME=your_email@gmail.com
NEWSLETTER_IMAP_PASSWORD=your_app_password
NEWSLETTER_IMAP_FOLDER=INBOX
NEWSLETTER_FROM_ALLOWLIST=tmtbreakout@substack.com
NEWSLETTER_USE_IDLE=true
NEWSLETTER_POLL_SECONDS=30
NEWSLETTER_DB_PATH=backend/data/newsletter.db
NEWSLETTER_ENCRYPTION_KEY=generate_with_python_-c_"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# OpenAI (for headline generation)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=20
